datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Category {
  id          String       @id @default(cuid())
  name        String       @unique
  slug        String       @unique
  description String?
  type        CategoryType @default(PRODUCT)
  isActive    Boolean      @default(true)
  products    Product[]    @relation("ProductCategory")
  videos      Video[]      @relation("VideoCategory")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("categories")
}

enum CategoryType {
  PRODUCT
  VIDEO
}

model Product {
  id                String    @id @default(cuid())
  stripeProductId   String    @unique @map("stripe_product_id")
  stripePriceId     String    @unique @map("stripe_price_id")
  name              String
  description       String?
  price             Float
  compareAtPrice    Float?    @map("compare_at_price")
  currency          String    @default("usd")
  images            Json
  categoryId        String?   @map("category_id")
  category          Category? @relation("ProductCategory", fields: [categoryId], references: [id])
  tags              Json
  inventoryCount    Int       @default(0) @map("inventory_count")
  isActive          Boolean   @default(true) @map("is_active")
  isDigital         Boolean   @default(false) @map("is_digital")
  weight            Float?
  metadata          Json?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  variants          Variant[] @relation("ProductVariants")
  orderItems        OrderItem[]

  @@map("products")
  @@index([stripeProductId])
  @@index([categoryId])
  @@index([isActive])
}

model Variant {
  id              String   @id @default(cuid())
  productId       String   @map("product_id")
  product         Product  @relation("ProductVariants", fields: [productId], references: [id], onDelete: NoAction)
  stripePriceId   String   @unique @map("stripe_price_id")
  name            String
  sku             String?  @unique
  price           Float
  inventoryCount  Int      @default(0) @map("inventory_count")
  attributes      Json
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("variants")
  @@index([productId])
  @@index([sku])
}

model Order {
  id              String       @id @default(cuid())
  stripeSessionId String?      @unique @map("stripe_session_id")
  stripePaymentId String?      @unique @map("stripe_payment_id")
  userId          String?      @map("user_id")
  user            User?        @relation(fields: [userId], references: [id])
  customerEmail   String       @map("customer_email")
  customerName    String?      @map("customer_name")
  customerPhone   String?      @map("customer_phone")
  address         Json?
  totalAmount     Float        @map("total_amount")
  currency        String       @default("usd")
  status          OrderStatus  @default(PENDING)
  paymentStatus   PaymentStatus @default(UNPAID) @map("payment_status")
  metadata        Json?
  items           OrderItem[]
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@map("orders")
  @@index([customerEmail])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String   @map("order_id")
  order           Order    @relation(fields: [orderId], references: [id], onDelete: NoAction)
  productId       String   @map("product_id")
  product         Product  @relation(fields: [productId], references: [id])
  variantId       String?  @map("variant_id")
  name            String
  quantity        Int
  price           Float
  currency        String   @default("usd")
  attributes      Json?

  @@map("order_items")
  @@index([orderId])
  @@index([productId])
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String?
  passwordHash    String?  @map("password_hash")
  role            UserRole @default(CUSTOMER)
  stripeCustomerId String? @unique @map("stripe_customer_id")
  emailVerified   Boolean  @default(false) @map("email_verified")
  orders          Order[]
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("users")
  @@index([email])
}

model Coupon {
  id              String       @id @default(cuid())
  code            String       @unique
  description     String?
  discountType    DiscountType @default(PERCENTAGE) @map("discount_type")
  discountValue   Float        @map("discount_value")
  minimumOrder    Float?       @map("minimum_order")
  maxUses         Int?         @map("max_uses")
  usedCount       Int          @default(0) @map("used_count")
  expiresAt       DateTime?    @map("expires_at")
  isActive        Boolean      @default(true) @map("is_active")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@map("coupons")
  @@index([code])
  @@index([isActive])
}

model Video {
  id          String       @id @default(cuid())
  title       String
  description String?
  youtubeId   String       @unique
  categoryId  String?      @map("category_id")
  category    Category?    @relation("VideoCategory", fields: [categoryId], references: [id])
  tags        String[]
  thumbnail   String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("videos")
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}

enum UserRole {
  CUSTOMER
  ADMIN
  STAFF
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}